<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Reacher</AssemblyName>
    <RootNamespace>Reacher</RootNamespace>
    <StartupObject>Reacher.Program</StartupObject>
    <Version>0.1.0</Version>
    <!-- WPF reads DPI awareness from the manifest; the WinForms-only alternative doesn't apply here. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

</Project>
